# 統一行尾，避免 Windows/Linux 部署時出現 CRLF 混雜
* text=auto eol=lf

*.html   text eol=lf
*.css    text eol=lf
*.js     text eol=lf
*.md     text eol=lf
*.svg    text eol=lf

# 二進位檔不可轉換行尾
*.jpg    binary
*.jpeg   binary
*.png    binary
*.webp   binary
*.ico    binary
*.gif    binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.eot    binary
